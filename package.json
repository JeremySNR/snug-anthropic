{
  "name": "@jeremysnr/snug-anthropic",
  "version": "0.1.1",
  "description": "snug for the Anthropic SDK. Fit messages into a token budget with automatic tool_use/tool_result pair handling.",
  "keywords": [
    "llm",
    "tokens",
    "context-window",
    "anthropic",
    "claude"
  ],
  "license": "MIT",
  "author": "Jeremy Smith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremySNR/snug-anthropic.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jeremysnr/snug": "^0.1.0",
    "tiktoken": "^1.0.22"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  }
}
